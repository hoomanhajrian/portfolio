# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.hoomanhajarian.com

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=you@example.com
# Sender; the domain must be verified in Resend (e.g. hoomanhajarian.com)
CONTACT_FROM_EMAIL="Portfolio <contact@hoomanhajarian.com>"

# Optional: secret for signing contact-form tokens (any long random string).
# If unset, a secret is derived from RESEND_API_KEY.
CONTACT_FORM_SECRET=

# Optional but recommended: Upstash Redis for rate limits shared across all server instances.
# Vercel → Storage/Marketplace → Upstash (Redis) sets these automatically.
# Without them, rate limits are kept in memory per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
